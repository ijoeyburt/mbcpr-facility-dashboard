[
  {
    "id": "opening",
    "title": "Opening checklist",
    "type": "checklist",
    "recurring": true,
    "cadence": "daily",
    "fields": [
      { "key": "skimmers", "label": "Empty skimmers" },
      { "key": "trash", "label": "Put trash bags in cans, ensure clean" },
      { "key": "systems", "label": "Turn on applicable systems (toys, music, lights)" },
      { "key": "backboard", "label": "Place backboard on deck, towel over head immobilizer" },
      { "key": "hippack", "label": "Put on hip pack, confirm gloves and CPR mask" },
      { "key": "facility_check", "label": "Facility safety and cleanliness check (bathrooms, entrances, pool, deck)" },
      { "key": "aed", "label": "AED check: green checkmark present" },
      { "key": "brush", "label": "Brush pool walls and reachable floor" },
      { "key": "fem_hygiene", "label": "Check feminine hygiene boxes, confirm bag in each" },
      { "key": "chems", "label": "Test chems (if permitted)" },
      { "key": "umbrellas", "label": "Place umbrellas at guard stands" },
      { "key": "lead_signoff", "label": "Lead guard sign-off", "type": "text", "placeholder": "Print name" }
    ]
  },
  {
    "id": "closing",
    "title": "Closing checklist",
    "type": "checklist",
    "recurring": true,
    "cadence": "daily",
    "fields": [
      { "key": "trash", "label": "Empty trash to dumpster, do not replace bags" },
      { "key": "toilets", "label": "Clean toilets" },
      { "key": "sinks", "label": "Clean sinks and mirrors" },
      { "key": "deck_pickup", "label": "Pick up pool deck" },
      { "key": "hippack_dry", "label": "Remove any wet first-aid supplies from hip pack" },
      { "key": "mop", "label": "Mop bathrooms" },
      { "key": "umbrellas_in", "label": "Bring in umbrellas" },
      { "key": "brush", "label": "Brush pool walls and reachable floor" },
      { "key": "fem_hygiene", "label": "Empty feminine hygiene boxes, replace bag" },
      { "key": "systems_off", "label": "Turn off applicable systems (toys, music, lights)" },
      { "key": "backboard_in", "label": "Bring backboard inside" },
      { "key": "final_check", "label": "Final facility cleanliness and safety check" },
      { "key": "lead_signoff", "label": "Lead guard sign-off", "type": "text", "placeholder": "Print name" }
    ]
  },
  {
    "id": "bathroom",
    "title": "Bathroom/deck check",
    "type": "checklist",
    "recurring": true,
    "intervalMinutes": 60,
    "note": "Complete at the half-hour mark, every hour (6:30, 7:30, 8:30...)",
    "fields": [
      { "key": "deck", "label": "Check deck, including trash cans" },
      { "key": "boys", "label": "Check boys bathroom" },
      { "key": "girls", "label": "Check girls bathroom" },
      { "key": "family", "label": "Check family bathroom" }
    ]
  },
  {
    "id": "maintenance",
    "title": "Maintenance",
    "type": "checklist",
    "recurring": true,
    "cadence": "daily",
    "fields": [
      { "key": "chems", "label": "Check chems" },
      { "key": "filter_psi", "label": "Check filter PSI, backwash if over 15" },
      { "key": "water_level", "label": "Check water level" },
      { "key": "cleanliness", "label": "Pool cleanliness check, vac as needed" },
      { "key": "skimmer_basket", "label": "Swap/clean pump skimmer basket (Lap: M/W/F/Sun, Kids: Tu/Th/Sat)" },
      { "key": "pump_room", "label": "Pump room inspection for leaks/issues" },
      { "key": "acid_check", "label": "Acid check: barrel filled enough for the day" },
      { "key": "warden_text", "label": "Text a picture of the pool wardens to Joe (304-901-9428)", "type": "check" }
    ]
  },
  {
    "id": "chem",
    "title": "Chem check",
    "type": "numeric",
    "recurring": true,
    "intervalHours": 2,
    "groups": [
      { "label": "Lap pool, deep end", "fields": [
        { "key": "lap_deep_ph", "label": "pH" },
        { "key": "lap_deep_cl", "label": "cL (ppm)" }
      ]},
      { "label": "Lap pool, shallow end", "fields": [
        { "key": "lap_shallow_ph", "label": "pH" },
        { "key": "lap_shallow_cl", "label": "cL (ppm)" }
      ]},
      { "label": "Toy pool, deep end", "fields": [
        { "key": "toy_deep_ph", "label": "pH" },
        { "key": "toy_deep_cl", "label": "cL (ppm)" }
      ]},
      { "label": "Toy pool, shallow end", "fields": [
        { "key": "toy_shallow_ph", "label": "pH" },
        { "key": "toy_shallow_cl", "label": "cL (ppm)" }
      ]}
    ]
  },
  {
    "id": "incident",
    "title": "Incident report",
    "type": "report",
    "recurring": false,
    "alertEmail": true,
    "fields": [
      { "key": "when", "label": "When did this happen?" },
      { "key": "location", "label": "Facility and location within facility" },
      { "key": "patrons", "label": "Patrons involved" },
      { "key": "staff", "label": "Staff involved" },
      { "key": "phone", "label": "Patron phone number (if needed)" },
      { "key": "whatHappened", "label": "What happened?", "type": "textarea" },
      { "key": "authorities", "label": "Were authorities contacted?" },
      { "key": "guardsInvolved", "label": "Print name of guards involved" },
      { "key": "leadSignoff", "label": "Lead guard: sign off on accuracy", "placeholder": "Print name" }
    ]
  },
  {
    "id": "referral",
    "title": "Referral (lead guard only)",
    "type": "report",
    "recurring": false,
    "alertEmail": true,
    "note": "A referral is not a write-up and is not final. It enters administrative review.",
    "fields": [
      { "key": "date", "label": "Date this occurred" },
      { "key": "staff", "label": "Staff involved" },
      { "key": "whatHappened", "label": "What happened?", "type": "textarea" },
      { "key": "verbalCorrection", "label": "Did you verbally correct the behavior?" },
      { "key": "correctedAfter", "label": "Did the staff correct behavior after the warning?" },
      { "key": "leadSignoff", "label": "Print your name to sign off on accuracy", "placeholder": "Print name" }
    ]
  }
]
